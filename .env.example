# Only user-edited configuration file: copy this to .env at repository root.
# Choregraphe: host.docker.internal in Compose; 127.0.0.1 without Docker.
# Real NAO: set its network address here. Never commit .env.
NAO_IP=host.docker.internal
NAO_PORT=9559

# Existing exercise data can be reused by pointing this at its current folder.
EXERCISES_HOST_DIR=./exercises

# Real NAO profile used by the team (enable only when the robot is prepared):
# NAO_IP=10.62.44.100
# NAO_PORT=9561
