# Copy this file to .env in the repository root. Run commands from that root.
# local: services call localhost ports; docker: services call Compose service names.
SERVICE_NETWORK=local

# Leave NAO_IP unset for local 127.0.0.1 / Docker host.docker.internal.
# Set it to the robot's current LAN IP for a real robot.
# NAO_IP=192.0.2.1
NAO_PORT=9559

# Host bind mounts for Docker Compose (relative to the root compose file).
POSE_IMAGES_HOST_DIR=./data/pose-images
EXERCISES_HOST_DIR=./data/exercises

# Optional image names for Docker builds.
REGISTRY=jperdek
TAG=latest
