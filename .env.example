# Only user-edited configuration file: copy this to .env at repository root.
# Choregraphe: host.docker.internal in Compose; 127.0.0.1 without Docker.
# Real NAO: set its network address here. Never commit .env.
NAO_IP=host.docker.internal
NAO_PORT=9559

# Prebuilt image namespace and tag; select a pinned release tag when available.
REGISTRY=ghcr.io/team26fiitstu
TAG=latest

# Existing exercise data can be reused by pointing this at its current folder.
EXERCISES_HOST_DIR=./exercises

# Retries for HTTP calls between services. A temporarily unavailable peer is
# retried HTTP_RETRY_MAX_ATTEMPTS times total; the delay grows from
# HTTP_RETRY_BACKOFF_SECONDS by HTTP_RETRY_BACKOFF_FACTOR after each attempt
# and never exceeds HTTP_RETRY_MAX_BACKOFF_SECONDS. HTTP_RETRY_STATUS_CODES
# lists the HTTP statuses that trigger a retry (client errors like 404 do not).
HTTP_RETRY_MAX_ATTEMPTS=3
HTTP_RETRY_BACKOFF_SECONDS=1
HTTP_RETRY_BACKOFF_FACTOR=2
HTTP_RETRY_MAX_BACKOFF_SECONDS=10
HTTP_RETRY_STATUS_CODES=429,500,502,503,504
# Joint temperature logs written by naoRobotAPI.
TEMPERATURE_LOG_HOST_DIR=./logs/temperature

# Real NAO profile used by the team (enable only when the robot is prepared):
# NAO_IP=10.62.44.100
# NAO_PORT=9561
