{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naomi.local/schemas/choreography.schema.json",
  "title": "NAOMI choreography",
  "description": "A graph of independently identified states that reference exercises.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "initial_state",
    "states",
    "transitions",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "description": "Choreography file format version."
    },
    "id": {
      "$ref": "#/$defs/id",
      "description": "Generated choreography ID."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "initial_state": {
      "$ref": "#/$defs/stateId",
      "description": "ID of one state in this choreography."
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/state"
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transition"
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}$",
      "description": "An eight-character choreography ID."
    },
    "stateId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "description": "A state ID chosen within the choreography."
    },
    "state": {
      "type": "object",
      "required": ["id", "exercise_id", "label", "x", "y"],
      "properties": {
        "id": {
          "$ref": "#/$defs/stateId",
          "description": "ID used to identify this state in the graph."
        },
        "exercise_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}$",
          "description": "ID of the exercise played by this state."
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "required": ["id", "from", "to", "label"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "$ref": "#/$defs/stateId",
          "description": "ID of a state in this choreography."
        },
        "to": {
          "$ref": "#/$defs/stateId",
          "description": "ID of a state in this choreography."
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
